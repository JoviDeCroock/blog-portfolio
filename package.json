{
  "name": "portfolio",
  "private": true,
  "description": "My own portfolio",
  "homepage": "https://jovidecroock.com/",
  "license": "MIT",
  "author": "Jovi De Croock",
  "type": "module",
  "scripts": {
    "prepare": "husky install",
    "dev": "pracht dev",
    "build": "pracht build && node scripts/inline-css.mjs dist/client",
    "og": "node scripts/generate-og.mjs",
    "preview": "pracht preview",
    "doctor": "pracht doctor",
    "typegen": "pracht typegen",
    "check-hydration": "HYDRATION_PROBE=1 pnpm build && node scripts/check-hydration.mjs dist/client"
  },
  "dependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@pracht/adapter-static": "^0.1.3",
    "@pracht/cli": "^1.13.0",
    "@pracht/core": "^0.17.0",
    "@pracht/vite-plugin": "^0.12.0",
    "preact": "11.0.0-rc.2",
    "preact-render-to-string": "^6.7.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.46.0",
    "playwright-core": "^1.62.1",
    "satori": "^0.28.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.2",
    "vite": "^8.2.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@8.6.7"
}
