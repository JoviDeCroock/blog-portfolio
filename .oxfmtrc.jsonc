{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Matching biome.json formatter config
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  // src/pracht*.ts(.d.ts) are written by `pracht typegen`; reformatting them
  // makes `pracht typegen --check` report them as stale on every run.
  "ignorePatterns": [
    "dist",
    "node_modules",
    "src/pracht.d.ts",
    "src/pracht-routes.ts",
  ],
}
